{
     "framework": null,
      "buildCommand": "node build.js",
       "outputDirectory": "public",
        "cleanUrls": true,
         "trailingSlash": true,
          "rewrites": [
            {
               "source": "/:convidado",
                  "destination": "/site/:convidado/index.html"
                    },
                      {
                         "source": "/:convidado/",
                            "destination": "/site/:convidado/index.html"
                              }
                               ],
                                "headers": [
                                  {
                                     "source": "/(.*)",
                                        "headers": [
                                            {
                                                 "key": "X-Content-Type-Options",
                                                      "value": "nosniff"
                                                          },
                                                              {
                                                                   "key": "Referrer-Policy",
                                                                        "value": "strict-origin-when-cross-origin"
                                                                            },
                                                                                {
                                                                                     "key": "X-Robots-Tag",
                                                                                          "value": "noindex"
                                                                                              }
                                                                                                 ]
                                                                                                   },
                                                                                                     {
                                                                                                        "source": "/fonts/(.*)",
                                                                                                           "headers": [
                                                                                                               {
                                                                                                                    "key": "Cache-Control",
                                                                                                                         "value": "public, max-age=31536000, immutable"
                                                                                                                             }
                                                                                                                                ]
                                                                                                                                  },
                                                                                                                                    {
                                                                                                                                       "source": "/formatura.ics",
                                                                                                                                          "headers": [
                                                                                                                                              {
                                                                                                                                                   "key": "Content-Type",
                                                                                                                                                        "value": "text/calendar; charset=utf-8"
                                                                                                                                                            }
                                                                                                                                                               ]
                                                                                                                                                                 }
                                                                                                                                                                  ]
                                                                                                                                                                  }
